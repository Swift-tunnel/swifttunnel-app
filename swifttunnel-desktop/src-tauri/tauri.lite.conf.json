{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftTunnel Lite",
  "identifier": "net.swifttunnel.lite",
  "build": {
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev:lite -- --port 1421",
    "beforeBuildCommand": "npm run build:lite"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "SwiftTunnel Lite"
      },
      {
        "label": "main",
        "title": "SwiftTunnel Lite",
        "width": 900,
        "height": 620
      }
    ]
  },
  "bundle": {
    "shortDescription": "SwiftTunnel Lite",
    "longDescription": "The SwiftTunnel tunnel and Roblox frame cap, without the rest of the app."
  }
}
