{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftTunnel Lite",
  "identifier": "net.swifttunnel.lite",
  "build": {
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev:lite -- --port 1421",
    "beforeBuildCommand": "npm run build:lite"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "SwiftTunnel Lite",
        "width": 460,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "focus": true,
        "visible": false
      },
      {
        "label": "main",
        "title": "SwiftTunnel Lite",
        "width": 780,
        "height": 560,
        "minWidth": 680,
        "minHeight": 520,
        "maxWidth": 1100,
        "maxHeight": 760,
        "maximizable": true,
        "decorations": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "shortDescription": "SwiftTunnel Lite",
    "longDescription": "The SwiftTunnel tunnel and Roblox frame cap, without the rest of the app.",
    "resources": [
      "resources/drivers",
      "resources/swifty.png"
    ]
  }
}
